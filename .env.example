# Copy to .env for local runs (never commit .env). In GitHub Actions these are repository secrets.

# Postgres in production (Neon/Supabase free tier works). Omit locally to use ./hunter_retention.db (SQLite).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Intuit developer app (production keys) for the Hunter Products QuickBooks company
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
# Only needed once to bootstrap; after that the rotating token lives in the database.
QBO_REFRESH_TOKEN=

# Apollo MASTER API key (Settings > Integrations > API > create key, toggle "Set as master key")
APOLLO_API_KEY=

# Optional: Teams/Slack incoming webhook for alerts
ALERT_WEBHOOK_URL=

# Optional: encrypt the stored QBO refresh token. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HP_TOKEN_KEY=

# Second safety key for real customer email. Leave unset until go-live.
HP_ALLOW_LIVE_SEND=
